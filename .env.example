# ============================================================================
# KmReal — variáveis de ambiente
# Copie para .env (desenvolvimento) ou cadastre na Vercel (Settings → Environment Variables).
# Nunca versione o .env com valores reais.
# ============================================================================

# --- Banco de dados (obrigatório) -------------------------------------------
# PostgreSQL usado pelo app em tempo de execução.
# Em produção serverless (Vercel), use a URL COM pooler (ex.: Neon "pooled", Supabase porta 6543).
# Local: rode `npm run db:dev` e use a URL TCP que ele mostrar.
DATABASE_URL="postgres://usuario:senha@host:5432/kmreal?sslmode=require"

# Conexão direta, SEM pooler — usada só pelas migrações (`prisma migrate deploy`) e pelo seed.
# Se o seu provedor não tem pooler, pode deixar vazio (usa DATABASE_URL).
# Neon na Vercel: copie o valor de DATABASE_URL_UNPOOLED.
DIRECT_URL=""

# Máximo de conexões por instância do app (opcional, padrão 5).
# DATABASE_POOL_MAX=5

# --- Autenticação (Auth.js) -------------------------------------------------
# Obrigatório. Segredo que assina a sessão (JWT). Gere com:
#   npx auth secret        ou        openssl rand -base64 32
# Trocar este valor desloga todos os usuários.
AUTH_SECRET=""

# URL pública do app. Local: http://localhost:3000.
# Na Vercel é detectada automaticamente; defina só se usar domínio próprio (ex.: https://app.kmreal.com.br).
# Também é a base do link enviado no e-mail de recuperação de senha.
AUTH_URL="http://localhost:3000"

# Nome antigo (NextAuth v4) da mesma URL — mantido por compatibilidade. Use o mesmo valor de AUTH_URL.
NEXTAUTH_URL="http://localhost:3000"

# --- Pagamentos (Cakto) -----------------------------------------------------
# Obrigatório para vender o PRO. É o mesmo "secret" configurado no webhook da Cakto
# (Cakto → Integrações/Webhooks → URL: https://SEU-APP/api/webhooks/cakto).
# Sem ele, o webhook responde 401 e nenhum pagamento ativa o PRO.
# Gere um valor longo e aleatório: openssl rand -hex 32
CAKTO_WEBHOOK_SECRET=""

# Link do checkout do plano PRO (opcional; padrão: https://pay.cakto.com.br/h2mn4pv_1166691)
# NEXT_PUBLIC_CAKTO_CHECKOUT_URL=""

# --- E-mail (recuperação de senha) ------------------------------------------
# Recomendado em produção. Sem a chave, o link de redefinição só aparece no log do servidor.
# Crie em https://resend.com → API Keys, e verifique o domínio do remetente.
RESEND_API_KEY=""
EMAIL_FROM="KmReal <nao-responda@seudominio.com.br>"

# --- Opcional ----------------------------------------------------------------
# Mostra o botão "Entrar com conta de demonstração" no login (use só em homologação,
# junto com `npm run db:seed`, que cria joao@kmreal.app / kmreal123).
NEXT_PUBLIC_ENABLE_DEMO_LOGIN="false"
